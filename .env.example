# ─── External Bridge Service ────────────────────────────────────────────────
NODE_ENV=development
PORT=5006
WORKER_PORT=5007

# ─── Redis (webhook history + GitHub activity cache) ────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Kafka ─────────────────────────────────────────────────────────────────
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092

# ─── OAuth (Google) ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub App (team activity API for the portal People page) ──────────────
# Create a GitHub App on the Team-Deepiri org with these read-only permissions:
#   Repository: Contents (R), Metadata (R), Pull requests (R)
#   Organization: Members (R)
# Subscribe it to the "Pull request" and "Pull request review" webhook events
# and point the webhook at  <gateway>/api/integrations/webhooks/github .
# Then install it on the org and read the installation id from the install URL.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Supply the App private key EITHER as a PEM (\n-escaped is fine) ...
GITHUB_APP_PRIVATE_KEY=
# ... OR base64-encoded (preferred for k8s secrets):  base64 -w0 key.pem
GITHUB_APP_PRIVATE_KEY_BASE64=
# Webhook secret — set the SAME value in the GitHub App's "Webhook secret" field.
# When set, deliveries to /webhooks/github with a missing/invalid
# X-Hub-Signature-256 are rejected (401). When empty, they're accepted unverified.
GITHUB_WEBHOOK_SECRET=

# Org to scan. Defaults to Team-Deepiri.
GITHUB_ORG=Team-Deepiri
# Comma-separated allow-list of repo names — STRONGLY recommended for the People
# page so /overview only fans out across the active product repos, e.g.
#   GITHUB_REPOS=deepiri-platform,deepiri-web-frontend,deepiri-api-gateway,deepiri-auth-service,deepiri-external-bridge-service
GITHUB_REPOS=
# When GITHUB_REPOS is empty, auto-discovery keeps only non-fork repos pushed to
# within this many days (dormant repos are skipped).
GITHUB_REPO_ACTIVE_DAYS=120
# Seconds a computed overview/stats payload is cached in Redis (min 30).
GITHUB_CACHE_TTL_SECONDS=600
# Override only for GitHub Enterprise Server.
GITHUB_API_BASE_URL=https://api.github.com
