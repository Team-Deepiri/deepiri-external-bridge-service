# Boardman wave-one production env template.
# Copy to .env.boardman.production in the target environment only.
# Do not commit real values.

# Deployment decisions
BOARDMAN_TARGET_ENV=vps-docker-compose
BOARDMAN_GITHUB_AUTH_MODE=github-app
BOARDMAN_QUEUE_MODE=kafka-compatible
BOARDMAN_WEBHOOK_URL=https://boardman.deepiri.com/webhooks/github
BOARDMAN_CONFIG_DIR=/app/config
BOARDMAN_SECRETS_ROTATED=0

# Runtime
NODE_ENV=production
PORT=5006
WORKER_PORT=5007
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
KAFKA_BROKERS=kafka:9092

# GitHub
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_ID=
GITHUB_ORG=Team-Deepiri
GITHUB_PAT=

# Plaky
PLAKY_API_KEY=
PLAKY_BASE_URL=https://api.plaky.com
PLAKY_WORKSPACE_ID=
PLAKY_BOARD_ID=
PLAKY_ITEM_GROUP_ID=
PLAKY_FIELD_EXTERNAL_KEY_ID=
PLAKY_FIELD_GITHUB_URL_ID=
PLAKY_FIELD_REPO_ID=
PLAKY_FIELD_STATUS_ID=
PLAKY_FIELD_PR_URL_ID=
PLAKY_FIELD_MERGE_STATE_ID=
PLAKY_STATUS_OPEN_VALUE=
PLAKY_STATUS_CLOSED_VALUE=
PLAKY_MERGE_STATE_OPEN_VALUE=
PLAKY_MERGE_STATE_MERGED_VALUE=
PLAKY_MERGE_STATE_CLOSED_VALUE=
PLAKY_MERGE_STATE_DRAFT_VALUE=

# Optional workflow fields/statuses
PLAKY_NEEDS_QA_STATUS=
PLAKY_IN_QA_STATUS=
PLAKY_PR_MERGE_STATUS=
PLAKY_FIELD_QA_ASSIGNEE_ID=
BOARDMAN_PR_AUTO_LINK_THRESHOLD=0.5

# Optional AI assistant providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Optional health/smoke status markers used by npm run boardman:status
API_HEALTH_URL=http://localhost:5006/health
WORKER_HEALTH_URL=http://localhost:5007/health
BOARDMAN_SMOKE_ISSUE_PASSED=
BOARDMAN_SMOKE_REPLAY_PASSED=
BOARDMAN_SMOKE_PR_LINKAGE_PASSED=
BOARDMAN_SMOKE_REVIEW_COMMENT_PASSED=
